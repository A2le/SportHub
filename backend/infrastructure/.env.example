# SportHub Bedrock Integration Environment Variables

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# SportHub API Configuration
SPORTHUB_API_BASE_URL=http://localhost:5000
SPORTHUB_API_KEY=your-api-key-here

# Bedrock Agent Configuration
AGENT_NAME=amusema-sports-agent
LAMBDA_FUNCTION_NAME=bedrock-sporthub-proxy
IAM_ROLE_NAME=BedrockAgentRole

# Optional: Custom model configuration
FOUNDATION_MODEL=anthropic.claude-3-sonnet-20240229-v1:0